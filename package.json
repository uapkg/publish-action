{
  "name": "@uapkg/publish-action",
  "description": "GitHub Action that submits uapkg publish requests to a registry repository",
  "version": "1.0.4",
  "author": "",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/uapkg/publish-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uapkg/publish-action.git"
  },
  "bugs": {
    "url": "https://github.com/uapkg/publish-action/issues"
  },
  "keywords": [
    "actions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "badge:make:all": "npm run badge:make:coverage && npm run badge:make:version && npm run badge:make:test && npm run badge:make:sha && npm run badge:make:links",
    "badge:make:coverage": "node ./script/make-badges.mjs coverage",
    "badge:make:version": "node ./script/make-badges.mjs version",
    "badge:make:test": "node ./script/make-badges.mjs test",
    "badge:make:sha": "node ./script/make-badges.mjs sha",
    "badge:make:links": "node ./script/make-badges.mjs links",
    "bundle": "npm run format:write && npm run package",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "ci-test": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "format:write": "npm run format:biome:write && npm run format:yaml:write",
    "format:check": "npm run format:biome:check && npm run format:yaml:check",
    "format:biome:write": "npx @biomejs/biome format --write .",
    "format:biome:check": "npx @biomejs/biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false .",
    "format:yaml:write": "npx prettier --write \"**/*.{yml,yaml}\"",
    "format:yaml:check": "npx prettier --check \"**/*.{yml,yaml}\"",
    "lint": "npm run lint:biome && npm run lint:yaml && npm run lint:actions",
    "lint:fix": "npm run lint:biome:fix && npm run format:yaml:write",
    "lint:biome": "npx @biomejs/biome lint .",
    "lint:biome:fix": "npx @biomejs/biome lint --write .",
    "lint:yaml": "npm run format:yaml:check",
    "lint:actions": "npx github-actionlint",
    "package": "node ./script/build.mjs",
    "package:watch": "npm run package -- --watch",
    "prepare": "husky",
    "precommit:cleanup": "node ./script/reset-local-badge-artifacts.mjs",
    "release:publish": "node ./script/release-publish.mjs",
    "smoke:release": "node ./script/post-build-smoke-check.mjs",
    "typecheck": "npx tsc -p tsconfig.test.json --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm run format:write && npm run lint && npm run typecheck && npm run test && npm run badge:make:all && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/action": "^8.0.4",
    "@uapkg/diagnostics": "^1.1.10",
    "@uapkg/diagnostics-format": "^1.1.10",
    "@uapkg/log": "^1.1.10",
    "@uapkg/package-manifest": "^1.1.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@changesets/cli": "^2.29.7",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "badge-maker": "^5.0.2",
    "ci-info": "^4.3.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "github-actionlint": "^1.7.12",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.8.4",
    "semver": "^7.8.5",
    "ts-jest": "^29.4.11",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^6.0.3"
  }
}

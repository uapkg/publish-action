{
  "name": "@uapkg/publish-action",
  "description": "GitHub Action that submits UAPKG publish requests to a registry repository",
  "version": "1.0.0",
  "author": "",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/uapkg/publish-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uapkg/publish-action.git"
  },
  "bugs": {
    "url": "https://github.com/uapkg/publish-action/issues"
  },
  "keywords": [
    "actions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "node ./script/build.mjs",
    "package:watch": "npm run package -- --watch",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run coverage && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/action": "^8.0.4",
    "@uapkg/diagnostics": "^1.1.10",
    "@uapkg/diagnostics-format": "^1.1.10",
    "@uapkg/log": "^1.1.10",
    "@uapkg/package-manifest": "^1.1.10"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@github/local-action": "^7.0.1",
    "@jest/globals": "^30.4.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-prettier": "^5.5.5",
    "esbuild": "^0.28.0",
    "jest": "^30.4.0",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^6.0.3"
  }
}
